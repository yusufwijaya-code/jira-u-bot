JIRA_BASE_URL=https://esb-id.atlassian.net
JIRA_EMAIL=you@esb.co.id
JIRA_API_TOKEN=replace-with-your-own-atlassian-api-token
GOOGLE_CHAT_WEBHOOK_URL=replace-with-the-nudge-space-webhook-url
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jira_db
HOLIDAY_CALENDAR_PATH=./config/holidays_id.json
PORT=8080
GOOGLE_CHAT_SELF_USER_ID=replace-with-users-slash-your-own-chat-user-id
GOOGLE_SIGNIN_CLIENT_ID=replace-with-oauth-client-id-type-web-application
GOOGLE_SIGNIN_CLIENT_SECRET=replace-with-oauth-client-secret
GOOGLE_SIGNIN_REDIRECT_URL=https://nudge.labcup.tech/auth/google/callback
ADMIN_EMAIL=yusuf.wijaya@esb.co.id
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key-openssl-rand-base64-32
# Kosong = app di root subdomain (nudge.labcup.tech). Isi (mis. /nudge) hanya kalau disajikan di bawah prefix.
BASE_PATH=
# Origin frontend Angular, hanya untuk dev lokal (kosongkan di produksi)
FRONTEND_URL=
# Google Chat App "Nudge" (Tech Spec "Nudge sebagai Google Chat App").
# Empty credentials file = app off; every message then goes through the operator DM.
GOOGLE_CHAT_APP_CREDENTIALS_FILE=
GOOGLE_CHAT_APP_PROJECT_NUMBER=275006361614
# One-click activation from the dashboard (false when the spike/ESB policy blocks it).
GOOGLE_CHAT_APP_ONE_CLICK=true
# Must be registered on the Sign-In OAuth client.
GOOGLE_CHAT_APP_ACTIVATION_REDIRECT_URL=https://nudge.labcup.tech/auth/chat-app/callback
# Gemini (Buat Card → normalize Task Breakdown). AI Studio key; free tier OK.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Auto Join Google Group: group in the Chat App Visibility list (empty = off)
# and the operator token from `./nudge --setup-groups-oauth`.
NUDGE_GROUP_EMAIL=
GOOGLE_GROUPS_TOKEN_PATH=./data/groups_oauth_token.json
# Desktop OAuth client of the project where the Cloud Identity API is enabled
# (empty = GOOGLE_OAUTH_CLIENT_ID/SECRET). Must be the client that issued the token.
GOOGLE_GROUPS_CLIENT_ID=
GOOGLE_GROUPS_CLIENT_SECRET=
